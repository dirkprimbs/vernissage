{
  "name": "@vernissage/studio",
  "version": "0.7.4",
  "private": true,
  "description": "Vernissage Studio \u2014 design 3D galleries and export them as static websites",
  "author": "Vernissage",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.mjs --external:electron --external:sharp --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "vite": "^8.3.8",
    "@vernissage/generator": "*",
    "@vernissage/schema": "*"
  },
  "homepage": "https://github.com/dirkprimbs/vernissage",
  "build": {
    "appId": "org.vernissage.studio",
    "productName": "Vernissage Studio",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../viewer/dist",
        "to": "viewer"
      },
      {
        "from": "../../demos",
        "to": "demos",
        "filter": [
          "**/*",
          "!**/.originals/**",
          "!**/.cache/**",
          "!**/sources*.json"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "Vernissage",
      "synopsis": "Design 3D galleries and export static websites",
      "executableName": "vernissage-studio",
      "syncDesktopName": true,
      "icon": "build/icons",
      "artifactName": "vernissage-studio-${version}-linux-${arch}.${ext}"
    },
    "npmRebuild": false,
    "extraMetadata": {
      "name": "vernissage-studio"
    },
    "artifactName": "vernissage-studio-${version}-${arch}.${ext}",
    "icon": "build/icon.png",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "vernissage-studio-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Vernissage Studio ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "vernissage-studio-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Vernissage Studio"
    }
  },
  "desktopName": "vernissage-studio.desktop"
}
